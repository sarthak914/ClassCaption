# Copy to .env.local (local dev) or add in Vercel → Project → Settings → Environment Variables.
# Write values right after "=", with no quotes and no comment on the same line
# (`docker run --env-file` would read a trailing "# comment" as part of the key).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# anon / publishable key (safe in the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role / secret key (server only!)
SUPABASE_SERVICE_ROLE_KEY=

# AI providers (server only)
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional
# Leave empty to auto-pick the newest Flash model your key can use.
GEMINI_MODEL=
# "Ask the lecture" finds the relevant transcript passages with Gemini embeddings + pgvector
# (run the v5 part of supabase/schema.sql). "off" sends the whole transcript instead.
ASK_RETRIEVAL=
GEMINI_EMBED_MODEL=
# Order of translators to try; each falls back to the next on error.
# Options: bhashini, indictrans2, gemini, groq, google
TRANSLATION_PROVIDERS=groq,gemini,google
BHASHINI_USER_ID=
BHASHINI_API_KEY=
# Self-hosted AI4Bharat IndicTrans2 (python indictrans2/server.py), e.g. http://localhost:7860
INDICTRANS2_URL=
INDICTRANS2_API_KEY=
# With INDICTRANS2_URL set, pure English captions go to IndicTrans2 and Hinglish goes to Groq/Gemini. "off" disables that.
INDICTRANS2_ROUTING=

# Security (all optional)
# Signs login cookies. Defaults to a value derived from SUPABASE_SERVICE_ROLE_KEY; set one to log everyone out when it changes.
SESSION_SECRET=
# Address phones open from the join QR code. Defaults to this laptop's Wi-Fi IP, e.g. http://192.168.1.37:4000
PUBLIC_BASE_URL=
# Set to true only when the app is served over https (marks cookies Secure).
COOKIE_SECURE=
# Student messages get a word filter plus a quick AI check when a key is set. "off" keeps only the word filter.
MODERATION_AI=

# Revision reminders (optional). Students who attended a class get 3 questions the next morning;
# with these keys they also get a phone notification (needs https, e.g. Vercel). Generate once with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for the push services, e.g. mailto:you@college.edu
VAPID_SUBJECT=
# Vercel Cron sends this to /api/cron/revisions (vercel.json, every morning 9:00 IST). Any long random string.
CRON_SECRET=
